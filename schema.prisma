datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PATIENT
  DOCTOR
  COMPOUNDER
  NURSE
  PHARMACY
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum ReminderStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum ReportType {
  PRESCRIPTION
  LAB
  IMAGING
  OTHER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         Role     @default(PATIENT)
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patientAppointments    Appointment[] @relation("PatientAppointments")
  providerAppointments   Appointment[] @relation("ProviderAppointments")
  orders                 Order[]
  reports                Report[]
  reminders              Reminder[]
  providerProfile        ProviderProfile?

  @@index([role])
}

model ProviderProfile {
  id           String @id @default(cuid())
  userId       String @unique
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  qualification String?
  specialization String?
  licenseNumber String?
  experienceYears Int?
  consultationFee Int?
  bio          String?
  isApproved   Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Appointment {
  id          String @id @default(cuid())
  patientId   String
  providerId  String
  scheduledAt DateTime
  address     String
  notes       String?
  status      AppointmentStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient  User @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  provider User @relation("ProviderAppointments", fields: [providerId], references: [id], onDelete: Cascade)

  @@index([patientId, scheduledAt])
  @@index([providerId, scheduledAt])
}

model Medicine {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Int
  stock       Int      @default(0)
  requiresRx  Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]

  @@index([name])
}

model Order {
  id            String      @id @default(cuid())
  patientId     String
  status        OrderStatus @default(PENDING)
  totalAmount   Int
  deliveryAddress String
  prescriptionReportId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  patient       User       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  items         OrderItem[]
  prescription  Report?    @relation(fields: [prescriptionReportId], references: [id], onDelete: SetNull)

  @@index([patientId, createdAt])
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  medicineId String
  quantity   Int
  unitPrice  Int

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id])
}

model Report {
  id         String     @id @default(cuid())
  patientId  String
  type       ReportType @default(OTHER)
  title      String
  fileName   String
  storageKey String
  mimeType   String
  createdAt  DateTime   @default(now())

  patient User @relation(fields: [patientId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@index([patientId, createdAt])
}

model Reminder {
  id          String @id @default(cuid())
  patientId   String
  title       String
  medicine    String?
  dosage      String?
  time        String
  frequency   String @default("DAILY")
  status      ReminderStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient User @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, status])
}
